@page
@model PrivacyModel
@{
    ViewData["Title"] = "Política de privacidad";
    ViewData["ShowHero"] = false;
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
            <li class="breadcrumb-item active" aria-current="page">Privacidad</li>
        </ol>
    </nav>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-body-tertiary">
        <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i> Política de privacidad</h5>
    </div>
    <div class="card-body">
        <p>
            Esta página describe cómo tratamos tus datos dentro de la aplicación <strong>Tareas_Cruds</strong>.
        </p>
        <ul>
            <li>No compartimos tus datos con terceros sin tu consentimiento.</li>
            <li>La información se utiliza únicamente para la gestión de tareas.</li>
            <li>Puedes solicitar la eliminación de tus datos en cualquier momento.</li>
        </ul>
        <p class="small text-body-secondary mb-0">
            Última actualización: @DateTime.Now.ToString("yyyy-MM-dd")
        </p>
    </div>
</div>
