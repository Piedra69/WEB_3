@page
@model Tareas_Cruds.Pages.CreateModel
@{
    ViewData["Title"] = "Nueva tarea";
    ViewData["ShowHero"] = false;
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-page="/Tareas/Index">Tareas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Crear</li>
        </ol>
    </nav>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-plus-lg me-2"></i> Crear nueva tarea</h5>
                <a asp-page="/Tareas/Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left-short me-1"></i> Volver
                </a>
            </div>

            <div class="card-body">
                <form method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Tarea.nombreTarea" class="form-label"></label>
                        <input asp-for="Tarea.nombreTarea" class="form-control" placeholder="Ej: Hacer informe mensual" />
                        <span asp-validation-for="Tarea.nombreTarea" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Tarea.fechaVencimiento" class="form-label"></label>
                            <input asp-for="Tarea.fechaVencimiento" type="date" class="form-control" />
                            <span asp-validation-for="Tarea.fechaVencimiento" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Tarea.estado" class="form-label"></label>
                            <select asp-for="Tarea.estado" class="form-select">
                                <option value="">-- Seleccionar --</option>
                                <option>Pendiente</option>
                                <option>En curso</option>
                                <option>Finalizado</option>
                            </select>
                            <span asp-validation-for="Tarea.estado" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label asp-for="Tarea.idUsuario" class="form-label"></label>
                        <input asp-for="Tarea.idUsuario" class="form-control" placeholder="ID del usuario" />
                        <span asp-validation-for="Tarea.idUsuario" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle me-1"></i> Guardar
                        </button>
                        <a asp-page="/Tareas/Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>

            <div class="card-footer bg-body-tertiary small text-body-secondary">
                Completa los campos y presiona <strong>Guardar</strong>.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
