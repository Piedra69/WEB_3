@page
@model Tareas_Cruds.Pages.DeleteModel
@{
    ViewData["Title"] = "Eliminar tarea";
    ViewData["ShowHero"] = false;
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-page="/Tareas/Index">Tareas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
        </ol>
    </nav>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary">
                <h5 class="mb-0 text-danger"><i class="bi bi-trash3 me-2"></i> Confirmar eliminación</h5>
            </div>

            <div class="card-body">
                <p class="lead">¿Seguro que deseas eliminar esta tarea? Esta acción no se puede deshacer.</p>

                <dl class="row">
                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tarea.nombreTarea)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(m => m.Tarea.nombreTarea)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tarea.fechaVencimiento)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(m => m.Tarea.fechaVencimiento)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tarea.estado)</dt>
                    <dd class="col-sm-9">
                        <span class="badge rounded-pill
                            @(Model.Tarea?.estado?.ToLower().Contains("final") == true ? "text-bg-success" :
                              Model.Tarea?.estado?.ToLower().Contains("curso") == true ? "text-bg-info" : "text-bg-secondary")">
                            @Html.DisplayFor(m => m.Tarea.estado)
                        </span>
                    </dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tarea.idUsuario)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(m => m.Tarea.idUsuario)</dd>
                </dl>
            </div>

            <div class="card-footer d-flex justify-content-between bg-body-tertiary">
                <a asp-page="/Tareas/Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-short me-1"></i> Volver
                </a>
                <form method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Tarea.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash3-fill me-1"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
