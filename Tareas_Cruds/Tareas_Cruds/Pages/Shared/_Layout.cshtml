@* Layout global: navbar + contenedor + footer. Empuja el footer abajo. *@
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is null ? "Tareas_Cruds" : ViewData["Title"] + " · Tareas_Cruds")</title>

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0d6efd" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Tareas_Cruds.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg bg-body-tertiary">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <i class="bi bi-check2-square fs-4 text-primary"></i>
                    <span class="fw-bold">Tareas_Cruds</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-page="/Index"><i class="bi bi-house-door me-1"></i>Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Tareas/Index"><i class="bi bi-list-check me-1"></i>Tareas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Privacy"><i class="bi bi-shield-lock me-1"></i>Privacidad</a></li>
                    </ul>

                    <form method="get" asp-page="/Tareas/Index" class="d-flex me-2" role="search">
                        <input class="form-control" type="search" name="q" placeholder="Buscar tareas…" aria-label="Buscar" />
                    </form>

                    <div class="d-flex align-items-center gap-2">
                        <button id="themeToggle" class="btn btn-outline-secondary btn-sm" type="button" title="Tema claro/oscuro">
                            <i class="bi bi-moon-stars"></i>
                        </button>
                        <a class="btn btn-primary btn-sm" asp-page="/Tareas/Create">
                            <i class="bi bi-plus-lg me-1"></i>Nueva tarea
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4 flex-grow-1">
        @RenderSection("Breadcrumbs", required: false)
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer mt-auto border-top py-4">
        <div class="container">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center small text-body-secondary">
                <div>© @DateTime.Now.Year Tareas_Cruds</div>
                <div>Hecho con <i class="bi bi-heart-fill"></i> y Bootstrap</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Tema persistente
        (function () {
            const key = "tareas.theme";
            const root = document.documentElement;
            const saved = localStorage.getItem(key);
            if (saved) root.setAttribute("data-bs-theme", saved);
            const btn = document.getElementById("themeToggle");
            const setIcon = () => btn && (btn.innerHTML =
                root.getAttribute("data-bs-theme") === "dark"
                ? '<i class="bi bi-brightness-high"></i>' : '<i class="bi bi-moon-stars"></i>');
            setIcon();
            btn?.addEventListener("click", () => {
                const next = (root.getAttribute("data-bs-theme") || "light") === "light" ? "dark" : "light";
                root.setAttribute("data-bs-theme", next);
                localStorage.setItem(key, next);
                setIcon();
            });
        })();

        // Nav activo
        (function () {
            const current = location.pathname.toLowerCase();
            document.querySelectorAll(".navbar .nav-link").forEach(a => {
                const href = a.getAttribute("href")?.toLowerCase();
                if (href && (href === current || (href !== "/" && current.startsWith(href)))) a.classList.add("active");
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
