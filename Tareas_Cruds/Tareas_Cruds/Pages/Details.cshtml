@page
@model Tareas_Cruds.Pages.DetailsModel
@{
    ViewData["Title"] = "Detalle de tarea";
    ViewData["ShowHero"] = false;
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/Index">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-page="/Tareas/Index">Tareas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Detalle</li>
        </ol>
    </nav>
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-card-text me-2"></i> Detalle de la tarea</h5>
                <div class="d-flex gap-2">
                    <a asp-page="/Tareas/Edit" asp-route-id="@Model.Tarea.Id" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil-square me-1"></i> Editar
                    </a>
                    <a asp-page="/Tareas/Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left-short me-1"></i> Volver
                    </a>
                </div>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tarea.nombreTarea)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(m => m.Tarea.nombreTarea)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tarea.fechaVencimiento)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(m => m.Tarea.fechaVencimiento)</dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tarea.estado)</dt>
                    <dd class="col-sm-9">
                        <span class="badge rounded-pill
                            @(Model.Tarea?.estado?.ToLower().Contains("final") == true ? "text-bg-success" :
                              Model.Tarea?.estado?.ToLower().Contains("curso") == true ? "text-bg-info" : "text-bg-secondary")">
                            @Html.DisplayFor(m => m.Tarea.estado)
                        </span>
                    </dd>

                    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Tarea.idUsuario)</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(m => m.Tarea.idUsuario)</dd>
                </dl>
            </div>

            <div class="card-footer bg-body-tertiary small text-body-secondary">
                ID interno: <code>@Model.Tarea.Id</code>
            </div>
        </div>
    </div>
</div>
