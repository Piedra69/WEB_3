@model Practica.Models.DetallePedido
@{
    ViewData["Title"] = "Agregar Detalle";
}
<style>
    :root {
        --bg: #f4f6f9;
        --fg: #333;
        --primary: #1a73e8;
        --border: #e5e7eb
    }

    body {
        background: var(--bg);
        color: var(--fg)
    }

    .container {
        max-width: 720px;
        margin: 24px auto;
        padding: 0 16px
    }

    .card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,.06);
        padding: 24px
    }

    .h1 {
        font-size: 1.5rem;
        margin: 0 0 16px
    }

    .form-group {
        margin-bottom: 1rem
    }

    .label {
        display: block;
        margin-bottom: .35rem;
        font-weight: 600
    }

    .form-control {
        width: 100%;
        padding: .6rem .75rem;
        border: 1px solid #d1d5db;
        border-radius: 8px
    }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 .2rem rgba(26,115,232,.15)
        }

    .validation {
        color: #b91c1c;
        margin: .5rem 0
    }

    .field-validation-error {
        color: #b91c1c;
        font-size: .9rem
    }

    .btn {
        padding: .55rem 1rem;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        cursor: pointer
    }

    .btn-primary {
        background: var(--primary);
        color: #fff
    }

    .btn-light {
        background: #f3f4f6
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px
    }
 

    {
        grid-template-columns: 1fr
    }

    }
</style>

<div class="container">
    <div class="card">
        <div class="h1">Agregar Detalle</div>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <form asp-action="Create" method="post">
            <div class="grid">
                <div class="form-group">
                    <label class="label" asp-for="PedidoId">Pedido</label>
                    <select class="form-control" asp-for="PedidoId" asp-items="ViewBag.PedidoId"></select>
                    <span asp-validation-for="PedidoId" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label class="label" asp-for="ProductoId">Producto</label>
                    <select class="form-control" asp-for="ProductoId" asp-items="ViewBag.ProductoId"></select>
                    <span asp-validation-for="ProductoId" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label class="label" asp-for="Cantidad"></label>
                    <input class="form-control" asp-for="Cantidad" />
                    <span asp-validation-for="Cantidad" class="field-validation-error"></span>
                </div>
                <div class="form-group">
                    <label class="label" asp-for="PrecioUnitario"></label>
                    <input class="form-control" asp-for="PrecioUnitario" />
                    <span asp-validation-for="PrecioUnitario" class="field-validation-error"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-light">Volver</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
