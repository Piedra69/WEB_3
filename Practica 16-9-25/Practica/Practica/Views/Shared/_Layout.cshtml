@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Practica</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Practica.styles.css" asp-append-version="true" />

    <style>
        body {
            overflow-x: hidden;
        }

        #sidebar {
            min-height: 100vh;
        }

        .sidebar-link {
            color: #fff;
            text-decoration: none;
            display: block;
            padding: 10px 15px;
        }

        .sidebar-link:hover {
            background-color: #495057;
        }

        .sidebar-heading {
            padding: 1rem;
            font-size: 1.25rem;
            background-color: #343a40;
            color: #fff;
        }

        .sidebar {
            background-color: #343a40;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block sidebar">
                <div class="sidebar-heading">
                    Practica App
                </div>
                <div class="list-group list-group-flush">
                    <a asp-controller="Home" asp-action="Index" class="sidebar-link">Inicio</a>
                    <a asp-controller="Clientes" asp-action="Index" class="sidebar-link">Clientes</a>
                    <a asp-controller="DetallePedidoes" asp-action="Index" class="sidebar-link">Detalle Pedidos</a>
                    <a asp-controller="Pedidoes" asp-action="Index" class="sidebar-link">Pedidos</a>
                    <a asp-controller="Productoes" asp-action="Index" class="sidebar-link">Productos</a>
                    <a asp-controller="Usuarios" asp-action="Index" class="sidebar-link">Usuarios</a>
                    <a asp-controller="Home" asp-action="Privacy" class="sidebar-link">Privacidad</a>
                </div>
            </nav>

            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            &copy; 2025 - Practica - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
