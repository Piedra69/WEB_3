@model Practica.Models.Cliente
@{
    ViewData["Title"] = "Eliminar Cliente";
}
<style>
/* estilos compactos */
:root{--bg:#f4f6f9;--fg:#333;--primary:#1a73e8;--border:#e5e7eb}
body{background:var(--bg);color:var(--fg)}
.container{max-width:720px;margin:24px auto;padding:0 16px}
.card{background:#fff;border:1px solid var(--border);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.06);padding:24px}
.h1{font-size:1.5rem;margin:0 0 8px}
.warn{background:#fef3c7;border:1px solid #f59e0b;padding:.75rem;border-radius:8px;margin-bottom:16px}
.btn{padding:.55rem 1rem;border-radius:8px;border:none;text-decoration:none;cursor:pointer}
.btn-danger{background:#dc3545;color:#fff}
.btn-light{background:#f3f4f6}
.dl{display:grid;grid-template-columns:180px 1fr;gap:8px 16px;margin:10px 0 16px}
.dt{font-weight:600;color:#555}
</style>

<div class="container">
    <div class="card">
        <div class="h1">Eliminar Cliente</div>
        <div class="warn">¿Seguro que deseas eliminar este cliente?</div>

        <div class="dl">
            <div class="dt">Id</div><div>@Model.ClienteId</div>
            <div class="dt">Nombre</div><div>@Model.Nombre</div>
            <div class="dt">Email</div><div>@Model.Email</div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="ClienteId" />
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a asp-action="Index" class="btn btn-light">Cancelar</a>
        </form>
    </div>
</div>
