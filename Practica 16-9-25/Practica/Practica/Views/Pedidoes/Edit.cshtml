@model Practica.Models.Producto
@{
    ViewData["Title"] = "Editar Producto";
}
<style>
    /* reutiliza estilos de formulario */
    :root {
        --bg: #f4f6f9;
        --fg: #333;
        --primary: #1a73e8;
        --border: #e5e7eb
    }

    body {
        background: var(--bg);
        color: var(--fg)
    }

    .container {
        max-width: 720px;
        margin: 24px auto;
        padding: 0 16px
    }

    .card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0,0,0,.06);
        padding: 24px
    }

    .h1 {
        font-size: 1.5rem;
        margin: 0 0 16px
    }

    .form-group {
        margin-bottom: 1rem
    }

    .label {
        display: block;
        margin-bottom: .35rem;
        font-weight: 600
    }

    .form-control {
        width: 100%;
        padding: .6rem .75rem;
        border: 1px solid #d1d5db;
        border-radius: 8px
    }

        .form-control:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 .2rem rgba(26,115,232,.15)
        }

    .validation {
        color: #b91c1c;
        margin: .5rem 0
    }

    .field-validation-error {
        color: #b91c1c;
        font-size: .9rem
    }

    .btn {
        padding: .55rem 1rem;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        cursor: pointer
    }

    .btn-primary {
        background: var(--primary);
        color: #fff
    }

    .btn-light {
        background: #f3f4f6
    }
</style>

<div class="container">
    <div class="card">
        <div class="h1">Editar Producto</div>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="ProductoId" />
            <div class="form-group">
                <label class="label" asp-for="Nombre"></label>
                <input class="form-control" asp-for="Nombre" />
                <span asp-validation-for="Nombre" class="field-validation-error"></span>
            </div>
            <div class="form-group">
                <label class="label" asp-for="Precio"></label>
                <input class="form-control" asp-for="Precio" />
                <span asp-validation-for="Precio" class="field-validation-error"></span>
            </div>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-light">Volver</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
