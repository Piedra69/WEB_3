@*
    _Layout.cshtml con sidebar offcanvas Bootstrap 5
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WAMVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WAMVC.styles.css" asp-append-version="true" />
    <style>
        /* Opcional: estilos mínimos para el botón del sidebar */
        .sidebar-toggle {
            border: none;
            background: transparent;
            padding: .25rem .5rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <!-- Botón para abrir el menú lateral -->
                <button class="sidebar-toggle me-2" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar"
                        aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <a class="navbar-brand" asp-area="" asp-controller="HomeModels" asp-action="Index">WAMVC</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#topNav" aria-controls="topNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="topNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="HomeModels" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="HomeModels" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Menú lateral Offcanvas -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="appSidebar" aria-labelledby="appSidebarLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="appSidebarLabel">Menú</h5>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
        </div>
        <div class="offcanvas-body p-0">
            <nav class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action"
                   asp-area="" asp-controller="HomeModels" asp-action="Index">
                    Inicio
                </a>

                <a class="list-group-item list-group-item-action"
                   asp-area="" asp-controller="ClienteModels" asp-action="Index">
                    Clientes
                </a>

                <a class="list-group-item list-group-item-action"
                   asp-area="" asp-controller="ProductoModels" asp-action="Index">
                    Productos
                </a>

                <a class="list-group-item list-group-item-action"
                   asp-area="" asp-controller="PedidoModels" asp-action="Index">
                    Pedidos
                </a>

                <a class="list-group-item list-group-item-action"
                   asp-area="" asp-controller="DetallePedidoModels" asp-action="Index">
                    Detalles de Pedido
                </a>
            </nav>
        </div>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - WAMVC - <a asp-area="" asp-controller="HomeModels" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
